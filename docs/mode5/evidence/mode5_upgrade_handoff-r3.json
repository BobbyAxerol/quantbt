        "required_coefficients": [
          "floor",
          "tail",
          "dispersion",
          "alpha"
        ]
      },
      "local_downside_v1": {
        "definition": "weighted_mean(center) - gamma * max(0,weighted_mean(center)-min(probe_aggregates)) - activity_penalty",
        "family": "local",
        "required_coefficients": [
          "gamma"
        ]
      },
