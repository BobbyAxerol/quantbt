+    advanced(&mut actual, 0, &[]);
+    original(&mut expected, 0, &[]);
+    let entry = place(1, 0, SIDE_BUY, ORDER_MARKET, [50.0, 0.0, 0.0]);
+    advanced(&mut actual, 1, &[entry]);
+    original(&mut expected, 1, &[entry]);
+    let liquidated = advanced(&mut actual, 2, &[]);
+    assert!(liquidated.liquidated);
+    assert_eq!(liquidated, original(&mut expected, 2, &[]));
+    assert_eq!(retry(&mut actual, &[]), liquidated);
+    actual.abort().unwrap();
+    assert!(!actual.session.as_ref().unwrap().liquidated);
+    assert_eq!(actual.session.as_ref().unwrap().positions, vec![50.0]);
+    assert_eq!(actual.session.as_ref().unwrap().next_bar(), 2);
+}
