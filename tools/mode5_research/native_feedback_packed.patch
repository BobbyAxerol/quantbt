+type PackedFeedback<'py> = (
+    Bound<'py, PyBytes>,
+    Bound<'py, PyBytes>,
+    Bound<'py, PyBytes>,
+    Bound<'py, PyBytes>,
+    Bound<'py, PyBytes>,
+);
+
+fn account_words<'a>(
+    result: &'a FullStepResult,
+    positions: &'a [f64],
+) -> impl Iterator<Item = [u8; 8]> + 'a {
+    std::iter::once(result.equity)
+        .chain(positions.iter().copied())
+        .chain([
+            result.fee,
+            result.funding,
+            result.turnover,
+            result.initial_margin,
+            result.maintenance_margin,
+        ])
+        .map(f64::to_ne_bytes)
+}
+
+fn integer_rows<const N: usize>(columns: [&[i64]; N]) -> impl Iterator<Item = [u8; 8]> {
+    (0..columns[0].len()).flat_map(move |row| columns.map(|column| column[row].to_ne_bytes()))
+}
+
+fn float_rows<const N: usize>(columns: [&[f64]; N]) -> impl Iterator<Item = [u8; 8]> {
+    (0..columns[0].len()).flat_map(move |row| columns.map(|column| column[row].to_ne_bytes()))
+}
+
+fn packed_words(
+    py: Python<'_>,
+    count: usize,
+    words: impl Iterator<Item = [u8; 8]>,
+) -> PyResult<Bound<'_, PyBytes>> {
+    let bytes = count
+        .checked_mul(8)
+        .filter(|size| *size <= isize::MAX as usize)
+        .ok_or_else(|| PyValueError::new_err("feedback packet exceeds Python bytes capacity"))?;
+    PyBytes::new_with(py, bytes, |output| {
+        for (destination, word) in output.chunks_exact_mut(8).zip(words) {
+            destination.copy_from_slice(&word);
+        }
+        Ok(())
+    })
+}
