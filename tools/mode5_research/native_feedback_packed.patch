+use super::*;
+use quantbt_domain::{ActivationPolicy, CommandAction, OrderType, Side, TimeInForce};
+use quantbt_engine::{EVENT_CANCEL, FullMarketData};
+use std::sync::Arc;
+
+const ACTION_PLACE: i64 = CommandAction::Place as i64;
+const ACTIVATION_ON_PARENT_FIRST_FILL: i64 = ActivationPolicy::OnParentFirstFill as i64;
+const ORDER_LIMIT: i64 = OrderType::Limit as i64;
+const ORDER_MARKET: i64 = OrderType::Market as i64;
+const ORDER_STOP_MARKET: i64 = OrderType::StopMarket as i64;
+const SIDE_BUY: i64 = Side::Buy as i64;
+const SIDE_SELL: i64 = Side::Sell as i64;
+const TIF_GTC: i64 = TimeInForce::Gtc as i64;
+
+type Command = ([i64; CODE_WIDTH], [f64; VALUE_WIDTH], i64);
+
+fn feedback_session(symbols: usize) -> NativeFeedbackSessionCore {
+    let market = FullMarketData::new(
+        vec![0, 1, 2, 3],
+        vec![100.0; 4 * symbols],
+        vec![110.0; 4 * symbols],
+        vec![90.0; 4 * symbols],
+        vec![100.0; 4 * symbols],
+        vec![1.0; 4 * symbols],
+        (0..4)
+            .flat_map(|bar| vec![if bar == 2 { 0.001 } else { 0.0 }; symbols])
+            .collect(),
+        vec![false, false, true, false],
+        symbols,
+    )
+    .unwrap();
+    let mut session = FullSession::new(
+        Arc::new(market),
+        vec![1.0; symbols],
+        vec![5.0; symbols],
+        vec![0.0002; symbols],
+        10_000.0,
+        0.005,
+        0.0,
+        true,
+    )
+    .unwrap();
+    session
+        .set_event_contract(
+            quantbt_engine::generated_contracts::CONTRACT_EVENT_LIFECYCLE_V3_NEXT_OPEN,
+        )
+        .unwrap();
+    NativeFeedbackSessionCore::wrap(session)
+}
+
+fn place(id: i64, symbol: i64, side: i64, kind: i64, values: [f64; VALUE_WIDTH]) -> Command {
+    let mut code = [0; CODE_WIDTH];
+    code[0] = ACTION_PLACE;
+    code[1] = symbol;
+    code[2] = side;
+    code[3] = kind;
+    code[4] = TIF_GTC;
+    code[6] = id;
+    code[7] = -1;
+    code[8] = -1;
+    code[9] = -1;
+    code[10] = -1;
+    (code, values, -1)
+}
+
+fn arrays(commands: &[Command]) -> (Vec<i64>, Vec<f64>, Vec<i64>) {
+    (
+        commands.iter().flat_map(|command| command.0).collect(),
+        commands.iter().flat_map(|command| command.1).collect(),
+        commands.iter().map(|command| command.2).collect(),
+    )
+}
+
+fn advanced(
+    feedback: &mut NativeFeedbackSessionCore,
+    bar: usize,
+    commands: &[Command],
+) -> FeedbackStepCore {
+    let (codes, values, expiry) = arrays(commands);
+    let result = feedback
+        .advance_step_result(bar, &codes, &values, &expiry)
+        .unwrap();
+    FeedbackStepCore::from_buffers(
+        result,
+        feedback.session.as_ref().unwrap().positions.clone(),
+        &feedback.buffers,
+    )
+}
+
+fn retry(feedback: &mut NativeFeedbackSessionCore, commands: &[Command]) -> FeedbackStepCore {
+    let (codes, values, expiry) = arrays(commands);
+    feedback.execute_step(&codes, &values, &expiry).unwrap()
+}
+
+fn original(
+    feedback: &mut NativeFeedbackSessionCore,
+    bar: usize,
+    commands: &[Command],
+) -> FeedbackStepCore {
+    feedback
+        .session
+        .as_mut()
+        .unwrap()
+        .begin_bar_transaction(bar)
+        .unwrap();
+    let result = retry(feedback, commands);
+    feedback
+        .session
+        .as_mut()
+        .unwrap()
+        .commit_bar_transaction()
+        .unwrap();
+    result
+}
+
+#[test]
+fn account_words_preserve_all_fields_and_native_float_bits() {
+    let result = FullStepResult {
+        equity: 123.0,
+        fee: 0.25,
+        funding: -0.5,
+        turnover: 200.0,
+        initial_margin: 40.0,
+        maintenance_margin: 1.0,
+        ..Default::default()
+    };
+    let positions = [2.0, -3.0, -0.0];
+    let actual = account_words(&result, &positions).collect::<Vec<_>>();
+    let expected = [123.0_f64, 2.0, -3.0, -0.0, 0.25, -0.5, 200.0, 40.0, 1.0]
+        .into_iter()
+        .map(f64::to_ne_bytes)
+        .collect::<Vec<_>>();
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn packed_rows_preserve_column_order_and_large_integer_ids() {
+    let large = (1_i64 << 53) + 1;
+    let columns = [
+        [1, 2],
+        [3, 4],
+        [large, large + 1],
+        [-1, large + 2],
+        [0, 1],
+        [10, 11],
+    ];
+    let actual = integer_rows(columns.each_ref().map(|column| column.as_slice()))
+        .map(i64::from_ne_bytes)
+        .collect::<Vec<_>>();
+    assert_eq!(
+        actual,
+        vec![1, 3, large, -1, 0, 10, 2, 4, large + 1, large + 2, 1, 11]
+    );
+    let floats = [[1.25, 2.5], [101.0, 99.0], [0.0002, -0.0]];
+    let actual = float_rows(floats.each_ref().map(|column| column.as_slice())).collect::<Vec<_>>();
+    assert_eq!(
+        actual,
+        [1.25_f64, 101.0, 0.0002, 2.5, 99.0, -0.0]
+            .into_iter()
+            .map(f64::to_ne_bytes)
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(integer_rows([&[][..]; 6]).count(), 0);
+    assert_eq!(float_rows([&[][..]; 3]).count(), 0);
+}
+
+#[test]
+fn deferred_commit_matches_original_multisymbol_session_and_empty_p0() {
+    let mut actual = feedback_session(2);
+    let mut expected = feedback_session(2);
+    let large = (1_i64 << 53) + 1;
+    let ignored_p0 = place(99, 0, SIDE_BUY, ORDER_MARKET, [1.0, 0.0, 0.0]);
+    let entry = place(large, 0, SIDE_BUY, ORDER_MARKET, [2.0, 0.0, 0.0]);
+    let other = place(large + 1, 1, SIDE_SELL, ORDER_MARKET, [3.0, 0.0, 0.0]);
+    let pending = place(large + 2, 0, SIDE_BUY, ORDER_LIMIT, [1.0, 50.0, 0.0]);
+    let steps = [
+        vec![ignored_p0],
+        vec![entry, other, pending],
+        vec![],
+        vec![],
+    ];
+    for (bar, commands) in steps.iter().enumerate() {
+        let observed = advanced(&mut actual, bar, commands);
+        assert_eq!(observed, original(&mut expected, bar, commands));
+        assert_eq!(
+            actual.session.as_ref().unwrap().active_bar_transaction(),
+            Some(bar)
+        );
+        if bar == 0 {
+            assert!(observed.fill_order_id.is_empty());
+            assert!(observed.event_order_id.is_empty());
+            assert_eq!(observed.positions, vec![0.0, 0.0]);
+        }
+        if bar == 2 {
+            assert!(observed.funding != 0.0);
+        }
+    }
+    actual
+        .session
+        .as_mut()
+        .unwrap()
+        .commit_bar_transaction()
+        .unwrap();
+    assert_eq!(actual.session.as_ref().unwrap().next_bar(), 4);
+    assert_eq!(
+        actual.session.as_ref().unwrap().active_bar_transaction(),
+        None
+    );
+}
