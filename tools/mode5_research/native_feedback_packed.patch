+#[test]
+fn malformed_and_wrong_order_advance_keep_pending_checkpoint_and_buffers() {
+    let mut feedback = feedback_session(1);
+    advanced(&mut feedback, 0, &[]);
+    let entry = place(1, 0, SIDE_BUY, ORDER_MARKET, [2.0, 0.0, 0.0]);
+    let tentative = advanced(&mut feedback, 1, &[entry]);
+    for bar in [0, 1, 3, 4, usize::MAX] {
+        assert!(feedback.advance_step_result(bar, &[], &[], &[]).is_err());
+        let session = feedback.session.as_ref().unwrap();
+        assert_eq!(session.active_bar_transaction(), Some(1));
+        assert_eq!(session.next_bar(), 2);
+        assert_eq!(session.positions, tentative.positions);
+        assert_eq!(feedback.buffers.fills.order_id, tentative.fill_order_id);
+    }
+    assert!(
+        feedback
+            .advance_step_result(2, &[0; CODE_WIDTH - 1], &[0.0; VALUE_WIDTH], &[0])
+            .is_err()
+    );
+    assert_eq!(
+        feedback.session.as_ref().unwrap().active_bar_transaction(),
+        Some(1)
+    );
+    assert_eq!(retry(&mut feedback, &[entry]), tentative);
+    assert_eq!(feedback.session.as_ref().unwrap().next_bar(), 2);
+    advanced(&mut feedback, 2, &[]);
+}
