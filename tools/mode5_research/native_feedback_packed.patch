+#[test]
+fn same_bar_retry_restores_oco_fees_and_fill_order_before_advance() {
+    let mut actual = feedback_session(1);
+    let mut expected = feedback_session(1);
+    advanced(&mut actual, 0, &[]);
+    original(&mut expected, 0, &[]);
+    let entry = place(1, 0, SIDE_BUY, ORDER_MARKET, [2.0, 0.0, 0.0]);
+    let mut stop = place(2, 0, SIDE_SELL, ORDER_STOP_MARKET, [2.0, 0.0, 95.0]);
+    stop.0[5] = 1;
+    stop.0[8] = 1;
+    stop.0[10] = 7;
+    stop.0[11] = ACTIVATION_ON_PARENT_FIRST_FILL;
+    let mut target = place(3, 0, SIDE_SELL, ORDER_LIMIT, [2.0, 105.0, 0.0]);
+    target.0[5] = 1;
+    target.0[8] = 1;
+    target.0[10] = 7;
+    target.0[11] = ACTIVATION_ON_PARENT_FIRST_FILL;
+    let tentative = advanced(&mut actual, 1, &[entry]);
+    assert_eq!(tentative.positions, vec![2.0]);
+    let chosen = retry(&mut actual, &[entry, stop, target]);
+    assert_eq!(chosen, original(&mut expected, 1, &[entry, stop, target]));
+    assert_eq!(chosen.positions, vec![0.0]);
+    assert_eq!(chosen.fill_order_id, vec![1, 2]);
+    assert!(chosen.event_kind.contains(&EVENT_CANCEL));
+    assert_eq!(retry(&mut actual, &[entry, stop, target]), chosen);
+    assert_eq!(
+        advanced(&mut actual, 2, &[]),
+        original(&mut expected, 2, &[])
+    );
+}
