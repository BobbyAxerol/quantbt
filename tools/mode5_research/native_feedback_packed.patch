+#[test]
+fn abort_reset_close_and_last_bar_flush_keep_original_semantics() {
+    let mut feedback = feedback_session(1);
+    advanced(&mut feedback, 0, &[]);
+    feedback.abort().unwrap();
+    assert_eq!(feedback.session.as_ref().unwrap().next_bar(), 0);
+    advanced(&mut feedback, 0, &[]);
+    let entry = place(1, 0, SIDE_BUY, ORDER_MARKET, [2.0, 0.0, 0.0]);
+    advanced(&mut feedback, 1, &[entry]);
+    feedback.reset().unwrap();
+    assert_eq!(feedback.session.as_ref().unwrap().next_bar(), 0);
+    assert_eq!(feedback.session.as_ref().unwrap().positions, vec![0.0]);
+    for bar in 0..4 {
+        advanced(&mut feedback, bar, &[]);
+    }
+    assert!(feedback.advance_step_result(4, &[], &[], &[]).is_err());
+    assert_eq!(
+        feedback.session.as_ref().unwrap().active_bar_transaction(),
+        Some(3)
+    );
+    feedback.commit().unwrap();
+    assert_eq!(
+        feedback.session.as_ref().unwrap().active_bar_transaction(),
+        None
+    );
+    feedback.close();
+    assert!(feedback.advance_step_result(0, &[], &[], &[]).is_err());
+    assert!(feedback.execute_step_result(&[], &[], &[]).is_err());
+}
